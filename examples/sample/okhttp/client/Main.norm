package sample.okhttp.client

import okhttp.client.RequestBuilder
import okhttp.client.requestBuilderNew
import okhttp.client.Request
import okhttp.client.OkHttpClient`r`nimport okio.ByteStringBuilder
import okhttp.client.okHttpClientBuilderNew
import okhttp.client.OkHttpClient
import okio.ByteString


private Void retainOkio(ByteString? value) {}

Void main() {
  RequestBuilder? builder = requestBuilderNew()
  if builder != null {
    Request? request =
      builder.url("https://example.com/api")?.header(arg0: "Accept", arg1: "text/plain")?.get()?.build()
    if request != null {
      printLine(request.method() ?? "")
      printLine(request.url()?.host() ?? "")
    }
  }

  OkHttpClientBuilder? clientBuilder = okHttpClientBuilderNew()
  if clientBuilder != null {
    OkHttpClient? client = clientBuilder.followRedirects(true)?.build()
    if client != null {
      printLine(client.callTimeoutMillis())
      printLine(client.followRedirects())
    }
  }
}
